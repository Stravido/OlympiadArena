<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.com.olympiad.client.gui.tictactoe.TicTacToeController"
      stylesheets="@../Scene.css"
      styleClass="background" alignment="CENTER" spacing="0">

    <VBox alignment="CENTER" styleClass="header">
        <Label text="TIC TAC TOE" styleClass="title"/>
        <HBox alignment="CENTER" spacing="32" styleClass="player-row">
            <VBox alignment="CENTER" spacing="2">
                <Label text="SPIELER 1" styleClass="player-label"/>
                <Label fx:id="score1Label" text="0" styleClass="player-score"/>
            </VBox>
            <Label text="·" styleClass="player-label"/>
            <VBox alignment="CENTER" spacing="2">
                <Label text="SPIELER 2" styleClass="player-label"/>
                <Label fx:id="score2Label" text="0" styleClass="player-score"/>
            </VBox>
        </HBox>
        <Label fx:id="statusLabel" text="Warte auf Zug..." styleClass="subtitle"/>
    </VBox>

    <!-- Board -->
    <GridPane fx:id="board" alignment="CENTER" styleClass="ttt-board"
              hgap="10" vgap="10" VBox.vgrow="ALWAYS">

        <Button fx:id="cell00" styleClass="ttt-cell" onAction="#onCellClick" userData="0,0" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button fx:id="cell01" styleClass="ttt-cell" onAction="#onCellClick" userData="0,1" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button fx:id="cell02" styleClass="ttt-cell" onAction="#onCellClick" userData="0,2" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

        <Button fx:id="cell10" styleClass="ttt-cell" onAction="#onCellClick" userData="1,0" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button fx:id="cell11" styleClass="ttt-cell" onAction="#onCellClick" userData="1,1" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button fx:id="cell12" styleClass="ttt-cell" onAction="#onCellClick" userData="1,2" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <Button fx:id="cell20" styleClass="ttt-cell" onAction="#onCellClick" userData="2,0" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button fx:id="cell21" styleClass="ttt-cell" onAction="#onCellClick" userData="2,1" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button fx:id="cell22" styleClass="ttt-cell" onAction="#onCellClick" userData="2,2" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

    </GridPane>

    <VBox alignment="CENTER" styleClass="footer-nav">
        <Button text="← Zurück" styleClass="btn-back" onAction="#onBack"/>
    </VBox>

</VBox>
